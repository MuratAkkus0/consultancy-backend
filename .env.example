NODE_ENV=development
APP_PORT=3001

# Web client the API links back to (emails, auth redirects)
APP_WEB_URL="http://localhost:3000"
APP_WEB_HOST="localhost"

# Better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3001"

# DB and Redis
DATABASE_URL="postgresql://campus69:localdev@localhost:5432/campus69"
# Only for a database on an untrusted network; leave empty for loopback
DATABASE_SSL_CA=""
AWS_REDIS_URL="redis://localhost:6379"

# AWS
AWS_STUDENT_DOCUMENTS_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Config
ALLOWED_ORIGINS="http://localhost:3000"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"
# Number of proxies in front of the app: 0 when it is exposed directly
TRUSTED_PROXY_HOPS="1"

# Email service
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@campus69.de"
SMTP_SECURE=true

# Web Push (optional) - generate keys with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https:// contact. Push is off unless all three are set.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:noreply@campus69.de"

# Seed (optional)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Log
LOG_LEVEL="debug"
