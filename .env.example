NODE_ENV=development
APP_HOST=localhost
APP_PORT=3001

# Better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# DB and Redis
DATABASE_URL=postgresql://milestonegermany:localdev@localhost:5432/milestonegermany
REDIS_URL=redis://localhost:6379

# AWS
AWS_STUDENT_DOCUMENTS_BUCKET_NAME=
AWS_REGION=

# Config
ALLOWED_ORIGINS="http://localhost:3001"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"
TRUSTED_PROXY_HOPS="1"

# Email service
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@milestonegermany.de"
APP_WEB_URL="https://www.milestonegermany.de"
SMTP_SECURE=true

# Log
LOG_LEVEL="debug"