# /etc/systemd/system/consultancy-backend.service
[Unit]
Description=Consultancy Backend API
After=network-online.target
Wants=network-online.target

# Give up after 5 failed starts in a minute instead of restarting forever.
# RestartSec=5 means the default 10s window never fills, so it is widened here.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple

User=deploy
Group=deploy
WorkingDirectory=/srv/consultancy-backend/current
EnvironmentFile=/srv/consultancy-backend/shared/.env

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

ExecStart=/usr/bin/node /srv/consultancy-backend/current/dist/server.js

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
