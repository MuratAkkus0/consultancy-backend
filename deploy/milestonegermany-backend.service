# /etc/systemd/system/milestonegermany-backend.service
[Unit]
Description=Milestonegermany Backend API
After=network.target

[Service]
Type=simple

User=admin
WorkingDirectory=/home/admin/consultancy-backend

ExecStart=/home/admin/consultancy-backend/deploy/start.sh

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target